              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Bootstrapped": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Reconfiguring": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stages",
              "commands",
              "situation",
              "result",
              "outcomes",
              "next"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+(-[a-z]+)*$"
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/stage"
                }
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/command_name"
                }
              },
              "situation": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "Accepted",
                  "Rejected",
                  "Probed"
                ]
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "enum": [
                    "ParticipationAccepted",
                    "ReadyAccepted",
                    "DuplicateParticipationIgnored",
                    "DuplicateReadyIgnored",
                    "NonMemberIgnored",
                    "LocalParticipationCompleted",
                    "BroadcastLocalReady",
                    "AcknowledgeRejoin",
                    "DeadlineMissed",
                    "EmitJoinRequest",
                    "MemberAdmitted",
                    "DuplicateMemberIgnored",
                    "JoinDenied",
                    "Concluded",
                    "SendMembership",
                    "ProposeAddition",
                    "AdditionWithdrawn",
                    "AcknowledgementIgnored",
                    "AbortIgnored",
                    "RequiredCountSet"
                  ]
                }
              },
              "next": {
                "description": "The stage after, or unchanged.",
                "enum": [
                  "Initial",
                  "Pinging",
                  "Collecting",
                  "Bootstrapped",
                  "Reconfiguring",
                  "unchanged"
                ]
              }
            }
          }
        }
      }
    }
  }
}
