      "description": "A u64 as a string of decimal digits: no sign, no leading zero, no exponent.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "nothing": {
      "description": "The payload of a value that carries nothing.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "peers": {
      "description": "Peer ids in arrival order, none twice.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/u64"
      }
    },
    "configuration": {
      "description": "What a node is created from: its own peer id, its genesis peers and the required count.",
