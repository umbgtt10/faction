          "description": "What each stage admits, by name, in the commands' order.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Initial",
            "Pinging",
            "Collecting",
            "Bootstrapped",
            "Reconfiguring",
            "Removed"
          ],
          "properties": {
            "Initial": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Pinging": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Collecting": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Bootstrapped": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Reconfiguring": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            },
            "Removed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/command_name"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stages",
              "commands",
              "situation",
              "result",
              "outcomes",
              "next"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+(-[a-z]+)*$"
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/stage"
                }
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/command_name"
                }
              },
              "situation": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "Accepted",
                  "Rejected",
                  "Probed"
                ]
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "enum": [
                    "ParticipationAccepted",
                    "ReadyAccepted",
                    "DuplicateParticipationIgnored",
                    "DuplicateReadyIgnored",
                    "NonMemberIgnored",
                    "LocalParticipationCompleted",
                    "BroadcastLocalReady",
                    "AcknowledgeRejoin",
                    "DeadlineMissed",
                    "EmitJoinRequest",
                    "MemberAdmitted",
                    "DuplicateMemberIgnored",
                    "JoinDenied",
                    "Concluded",
                    "SendMembership",
                    "ProposeAddition",
                    "AdditionWithdrawn",
                    "AcknowledgementIgnored",
                    "AbortIgnored",
                    "ProposeRemoval",
                    "RemovalRefused",
                    "RemovalWithdrawn",
                    "MemberRemoved",
                    "RequiredCountSet",
                    "SendProbe",
                    "NothingToProbe",
                    "SendIndirectProbes",
                    "MissCounted",
                    "PeerSuspected",
                    "PeerRevived",
                    "AliveNoted",
                    "AlreadySuspected",
                    "SelfIgnored",
                    "QuorumLost",
                    "QuorumRestored"
                  ]
                }
              },
              "next": {
                "description": "The stage after, or unchanged.",
                "enum": [
                  "Initial",
                  "Pinging",
                  "Collecting",
                  "Bootstrapped",
                  "Reconfiguring",
                  "Removed",
                  "unchanged"
                ]
              }
            }
          }
        }
      }
    }
