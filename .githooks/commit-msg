#!/bin/sh
# Every commit message carries the library's crates, under crates/, scored as
# staged: each one's grip, its braintax and their ratio, then the sums, written
# in above its trailers by `cargo xtask grip-braintax`. Enabled once a clone by
# `just hooks`; a scoring that fails stops the commit.
exec cargo xtask grip-braintax "$1"
